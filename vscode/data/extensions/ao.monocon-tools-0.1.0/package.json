{
    "name": "monocon-tools",
    "displayName": "Monocon Tools",
    "publisher": "ao",
    "version": "0.1.0",
    "description": "高校生ものづくりコンテスト向けのArduino書き込み・課題フォルダー作成ツール",
    "icon": "icon.ico",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "arduino",
        "monocon",
        "serial monitor",
        "高校生ものづくりコンテスト"
    ],
    "extensionKind": [
        "ui"
    ],
    "os": [
        "win32"
    ],
    "cpu": [
        "x64"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "monoconTools.uploadArduino",
                "title": "Arduinoへ書き込み",
                "category": "Monocon Tools"
            },
            {
                "command": "monoconTools.compileArduino",
                "title": "Arduinoをコンパイル",
                "category": "Monocon Tools"
            },
            {
                "command": "monoconTools.createTaskFolders",
                "title": "課題フォルダーを一括作成",
                "category": "Monocon Tools"
            },
            {
                "command": "monocon.upload",
                "title": "Arduinoへ書き込み（旧ID）",
                "category": "Monocon Tools"
            },
            {
                "command": "template.generate",
                "title": "課題フォルダーを一括作成（旧ID）",
                "category": "Monocon Tools"
            }
        ],
        "keybindings": [
            {
                "command": "monoconTools.uploadArduino",
                "key": "f2",
                "when": "editorTextFocus && resourceExtname == .ino"
            },
            {
                "command": "monoconTools.uploadArduino",
                "key": "ctrl+space",
                "when": "editorTextFocus && resourceExtname == .ino"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "monoconTools.createTaskFolders",
                    "group": "2_workspace"
                }
            ],
            "commandPalette": [
                {
                    "command": "monocon.upload",
                    "when": "false"
                },
                {
                    "command": "template.generate",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "Monocon Tools",
            "properties": {
                "monoconTools.taskFolders.baseName": {
                    "type": "string",
                    "default": "mon",
                    "description": "ファイル名入力欄に表示する既定の基本名（例: mon1）"
                },
                "monoconTools.upload.baudRate": {
                    "type": "integer",
                    "default": 9600,
                    "minimum": 1,
                    "maximum": 4000000,
                    "description": "書き込み後に再開するシリアルモニターのボーレート"
                },
                "monoconTools.upload.port": {
                    "type": "string",
                    "default": "",
                    "pattern": "^$|^COM[1-9][0-9]*$",
                    "patternErrorMessage": "COM3 のようなWindowsのCOMポート名を指定してください。",
                    "description": "書き込み先のCOMポート。空欄では自動検出し、候補が複数ある場合だけ選択画面を表示します"
                },
                "monoconTools.upload.reopenMonitor": {
                    "type": "boolean",
                    "default": true,
                    "description": "書き込み前に監視していたシリアルポートを、書き込み後に再度開く"
                },
                "monoconTools.upload.reopenDelayMs": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 10000,
                    "description": "書き込み完了からシリアルモニターを再開するまでの待機時間"
                },
                "monoconTools.upload.portReleaseDelayMs": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "シリアルモニター停止後、書き込み開始までポート解放を待つ時間"
                },
                "monoconTools.upload.taskTimeoutMs": {
                    "type": "integer",
                    "default": 180000,
                    "minimum": 10000,
                    "maximum": 600000,
                    "description": "Arduino書き込みタスクが応答しない場合に中止するまでの時間"
                },
                "monoconTools.upload.serialOperationTimeoutMs": {
                    "type": "integer",
                    "default": 5000,
                    "minimum": 1000,
                    "maximum": 30000,
                    "description": "シリアルモニターの停止・再開が応答しない場合の待機上限"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run check",
        "compile": "npm run check",
        "check": "node --check ./out/extension.js && node --check ./out/arduino-upload.js && node --check ./out/compiler-report.js && node --check ./out/task-folders.js && node --check ./out/upload-status.js && node --check ./out/native-service.js && node --check ./out/native-worker.js",
        "test": "node --test ./test/*.test.js"
    },
    "devDependencies": {
        "@types/node": "^18.19.130",
        "@types/vscode": "^1.80.0"
    },
    "__metadata": {
        "installedTimestamp": 1779508662908,
        "targetPlatform": "undefined",
        "size": 22000
    }
}
